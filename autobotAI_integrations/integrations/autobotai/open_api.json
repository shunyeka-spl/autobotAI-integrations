    "/guardian/tasks/{task_id}/related": {
      "get": {
        "summary": "Get Related Tasks and Subgraph",
        "description": "Retrieves sibling tasks and the associated entity relationship subgraph for a specific Guardian task.",
        "operationId": "getRelatedGuardianTasks",
        "parameters": [
          { 
            "name": "task_id", 
            "in": "path", 
            "required": true, 
            "schema": { "type": "string" },
            "description": "The unique ID of the Guardian task (e.g., TASK-b90f618553b3)."
          }
        ],
        "responses": {
          "200": { "description": "Successful Response" }
        }
      }
    },
    "/guardian/tasks/{task_id}/transition": {
      "post": {
        "summary": "Transition Guardian Task Status",
        "description": "Manually transitions a Guardian task to a new workflow status (e.g., COMPLETED, FAILED, IN_PROGRESS).",
        "operationId": "transitionGuardianTask",
        "parameters": [
          { 
            "name": "task_id", 
            "in": "path", 
            "required": true, 
            "schema": { "type": "string" },
            "description": "The unique ID of the Guardian task to transition (e.g., TASK-b90f618553b3)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_status": { 
                    "type": "string", 
                    "enum": ["NEW", "IN_PROGRESS", "WAITING_HUMAN", "WAITING_SYSTEM", "WAITING_APPROVAL", "ESCALATED", "COMPLETED", "FAILED"],
                    "description": "Target status. Must be one of: NEW, IN_PROGRESS, WAITING_HUMAN, WAITING_SYSTEM, WAITING_APPROVAL, ESCALATED, COMPLETED, FAILED."
                  },
                  "note": { 
                    "type": "string", 
                    "description": "Optional: explanatory text note describing the reason for this transition." 
                  },
                  "disposition": { 
                    "type": "string", 
                    "enum": ["pending", "auto_remediated", "manual_ticket", "exception", "suppressed", "no_action", "escalated"],
                    "description": "Optional workflow resolution type: pending, auto_remediated, manual_ticket, exception, suppressed, no_action, escalated."
                  },
                  "outcome": { 
                    "type": "string", 
                    "enum": ["TRUE_POSITIVE", "FALSE_POSITIVE", "BENIGN", "CONFIRMED", "NEEDS_INVESTIGATION", "UNKNOWN"],
                    "description": "Optional validation verdict: TRUE_POSITIVE, FALSE_POSITIVE, BENIGN, CONFIRMED, NEEDS_INVESTIGATION, UNKNOWN."
                  }
                },
                "required": ["to_status"],
                "example": {
                  "to_status": "COMPLETED",
                  "note": "Issue resolved successfully",
                  "disposition": "auto_remediated",
                  "outcome": "TRUE_POSITIVE"
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful Response" }
        }
      }
    },
    "/guardian/tasks/{task_id}/assign": {
      "post": {
        "summary": "Assign Guardian Task",
        "description": "Assigns a Guardian task to an analyst email reference.",
        "operationId": "assignGuardianTask",
        "parameters": [
          { 
            "name": "task_id", 
            "in": "path", 
            "required": true, 
            "schema": { "type": "string" },
            "description": "The unique ID of the Guardian task (e.g., TASK-b90f618553b3)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "assignee_ref": { 
                    "type": "string",
                    "description": "Unique identifier (typically an email address) of the human analyst to assign this task to."
                  }
                },
                "example": {
                  "assignee_ref": "analyst@company.com"
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful Response" }
        }
      }
    },
    "/guardian/tasks/{task_id}/comment": {
      "post": {
        "summary": "Comment on Guardian Task",
        "description": "Appends an audit comment or note to the task timeline.",
        "operationId": "commentGuardianTask",
        "parameters": [
          { 
            "name": "task_id", 
            "in": "path", 
            "required": true, 
            "schema": { "type": "string" },
            "description": "The unique ID of the Guardian task (e.g., TASK-b90f618553b3)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "note": { 
                    "type": "string",
                    "description": "The comment or update note to post to the task timeline."
                  }
                },
                "required": ["note"],
                "example": {
                  "note": "Checking the scanner logs..."
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful Response" }
        }
      }
    },
    "/guardian/tasks/{task_id}/apply": {
      "post": {
        "summary": "Apply Completion to Guardian Task",
        "description": "Applies multiple completion updates (owner, outcome, disposition, etc.) in a single call.",
        "operationId": "applyGuardianTaskCompletion",
        "parameters": [
          { 
            "name": "task_id", 
            "in": "path", 
            "required": true, 
            "schema": { "type": "string" },
            "description": "The unique ID of the Guardian task (e.g., TASK-b90f618553b3)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_status": { 
                    "type": "string",
                    "description": "Optional: target status to transition the task to (e.g., COMPLETED, FAILED)."
                  },
                  "note": { 
                    "type": "string",
                    "description": "Optional: explanatory audit note summarizing the work completed."
                  },
                  "disposition": { 
                    "type": "string",
                    "description": "Optional workflow resolution type (e.g., auto_remediated, manual_ticket, exception)."
                  },
                  "outcome": { 
                    "type": "string",
                    "description": "Optional validation verdict (e.g., TRUE_POSITIVE, FALSE_POSITIVE, BENIGN)."
                  },
                  "owner_ref": { 
                    "type": "string",
                    "description": "Optional: email address of the risk owner."
                  },
                  "owner_resolution": { 
                    "type": "object",
                    "description": "Optional: custom owner-specific resolution metadata."
                  },
                  "entities": { 
                    "type": "array", 
                    "items": { "type": "object" },
                    "description": "Optional: list of entity references (e.g., [{'type': 'file', 'ref': 'app/main.py'}]) to bind to the task's subgraph."
                  },
                  "links": { 
                    "type": "object",
                    "description": "Optional: external URLs/links associated with the fix (e.g., VCS PR URL)."
                  },
                  "final_action": { 
                    "type": "string",
                    "description": "Optional: final action description."
                  },
                  "final_action_target": { 
                    "type": "string",
                    "description": "Optional: target resource of the final action."
                  },
                  "actor": { 
                    "type": "string",
                    "description": "Optional: system actor identifier performing this update."
                  }
                },
                "example": {
                  "to_status": "COMPLETED",
                  "note": "Resolved by automation",
                  "disposition": "auto_remediated",
                  "outcome": "TRUE_POSITIVE",
                  "owner_ref": "agent@autobot.live"
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful Response" }
        }
      }
    },
    "/guardian/apps": {
      "get": {
        "summary": "List AppSec Workloads",
        "description": "Retrieves the list of all registered AppSec harness workloads for the tenant.",
        "operationId": "listAppsecWorkloads",
        "responses": {
          "200": { "description": "Successful Response" }
        }
      },
      "post": {
        "summary": "Register AppSec Workload",
        "description": "Registers or updates a workload harness config for automatic scanning, routing, and deepagent resolution.",
        "operationId": "registerAppsecWorkload",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "application": { 
                    "type": "string", 
                    "description": "The unique name/slug for the workload application (e.g., test-app)." 
                  },
                  "resolver_listener_id": { 
                    "type": "string", 
                    "description": "ID of the event listener configured to trigger the resolver run." 
                  },
                  "resolver_bot_id": { 
                    "type": "string", 
                    "description": "The unique ID of the resolver deepagent bot. Find via 'List Bots' action." 
                  },
                  "pentest_bot_id": { 
                    "type": "string", 
                    "description": "Optional: unique ID of the active pentesting/SAST bot." 
                  },
                  "sweeper_bot_id": { 
                    "type": "string", 
                    "description": "Optional: unique ID of the cleanup/sweeper bot." 
                  },
                  "repo_integration_id": { 
                    "type": "string", 
                    "description": "The account ID of the VCS integration (GitHub/GitLab). Find via 'List Integrations' action." 
                  },
                  "repos": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "repo_url": { "type": "string" },
                        "base_branch": { "type": "string" }
                      },
                      "required": ["repo_url"]
                    }
                  },
                  "scan_targets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": { "type": "string", "enum": ["image", "code", "url"] },
                        "ref": { "type": "string" },
                        "scanner": { "type": "string" }
                      },
                      "required": ["type", "ref"]
                    }
                  },
                  "external_sources": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "default_approver": { 
                    "type": "string",
                    "description": "Fallback reviewer email/username when owner auto-resolution cannot be matched."
                  },
                  "min_severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low", "Informational"] },
                  "default_sla_hours": { "type": "integer" },
                  "goal_details": { "type": "object" }
                },
                "required": ["application", "resolver_listener_id"],
                "example": {
                  "application": "test-app",
                  "resolver_listener_id": "listener-12345",
                  "resolver_bot_id": "bot-12345",
                  "repos": [
                    {
                      "repo_url": "https://github.com/org/repo.git",
                      "base_branch": "main"
                    }
                  ],
                  "scan_targets": [
                    {
                      "type": "code",
                      "ref": "main",
                      "scanner": "trivy"
                    }
                  ],
                  "default_approver": "approver@company.com",
                  "min_severity": "High",
                  "default_sla_hours": 24
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful Response" }
        }
      }
    },
    "/guardian/apps/{application}": {
      "delete": {
        "summary": "Deregister AppSec Workload",
        "description": "Permanently removes a workload harness configuration from the registry.",
        "operationId": "deregisterAppsecWorkload",
        "parameters": [
          { "name": "application", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Successful Response" }
        }
      }
    }
  }
}
