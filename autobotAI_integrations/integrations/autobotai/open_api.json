    "/guardian/tasks/record": {
      "post": {
        "summary": "Record Guardian Tasks",
        "description": "Batch create or update discovered work items (tasks) in the Guardian task register. Idempotent based on source, source_event_id, and application.",
        "operationId": "recordGuardianTasks",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tasks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": { "type": "string" },
                        "name": { "type": "string" },
                        "domain": { "type": "string", "enum": ["security", "cloud_ops", "observability", "cost", "identity", "compliance"] },
                        "category": { "type": "string" },
                        "source_event_id": { "type": "string" },
                        "description": { "type": "string" },
                        "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low", "Informational"] },
                        "application": { "type": "string" },
                        "team": { "type": "string" },
                        "owner_ref": { "type": "string" },
                        "assignee_ref": { "type": "string" }
                      },
                      "required": ["source", "name", "domain", "category"]
                    }
                  }
                },
                "required": ["tasks"],
                "example": {
                  "tasks": [
                    {
                      "source": "my-scanner",
                      "name": "Unencrypted S3 Bucket",
                      "domain": "security",
                      "category": "cloud_misconfig",
                      "source_event_id": "event-12345",
                      "description": "Found a public bucket",
                      "severity": "High",
                      "application": "my-payment-service"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/guardian/tasks": {
      "get": {
        "summary": "List Guardian Tasks",
        "description": "Retrieves a list of Guardian tasks with rich filters and pagination.",
        "operationId": "listGuardianTasks",
        "parameters": [
          { "name": "application", "in": "query", "description": "Filter by application/workload name. Supports comma-separated list of multiple names.", "required": false, "schema": { "type": "string" } },
          { "name": "severity", "in": "query", "description": "Comma-separated severities to filter", "required": false, "schema": { "type": "string" } },
          { "name": "domain", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "category", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "status", "in": "query", "description": "Comma-separated statuses to filter", "required": false, "schema": { "type": "string" } },
          { "name": "team", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "owner_ref", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "assignee_ref", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "source", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "disposition", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "outcome", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "parent_task_ref", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "search", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "open_only", "in": "query", "required": false, "schema": { "type": "boolean", "default": false } },
          { "name": "waiting_only", "in": "query", "required": false, "schema": { "type": "boolean", "default": false } },
          { "name": "sla_breached", "in": "query", "required": false, "schema": { "type": "boolean", "default": false } },
          { "name": "unowned", "in": "query", "required": false, "schema": { "type": "boolean", "default": false } },
          { "name": "unassigned", "in": "query", "required": false, "schema": { "type": "boolean", "default": false } },
          { "name": "sort_by", "in": "query", "required": false, "schema": { "type": "string", "default": "sla_deadline" } },
          { "name": "descending", "in": "query", "required": false, "schema": { "type": "boolean", "default": false } },
          { "name": "number_of_items", "in": "query", "required": false, "schema": { "type": "integer", "default": 25 } },
          { "name": "page_number", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": { "description": "Successful Response" }
        }
      }
    },
